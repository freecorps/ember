{
  "name": "@freecorps/ember-auth",
  "version": "0.5.2",
  "description": "Better Auth for Ember, running in a dedicated Durable Object with short-lived JWTs.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "auth",
    "better-auth",
    "jwt"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/auth"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@freecorps/ember-source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./plugins": {
      "@freecorps/ember-source": "./src/plugins.ts",
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/api-key": "~1.7.17",
    "@better-auth/core": "~1.7.17",
    "@better-auth/utils": "0.5.1",
    "better-auth": "~1.7.17",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@better-auth/test-utils": "~1.7.17",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "wrangler": "^4.157.0"
  }
}
