{
  "name": "@freecorps/ember-auth",
  "version": "0.8.1",
  "description": "Better Auth for Ember, running in a dedicated Durable Object with short-lived JWTs.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "auth",
    "better-auth",
    "jwt"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/auth"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@freecorps/ember-source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./lazy": {
      "@freecorps/ember-source": "./src/lazy.ts",
      "types": "./dist/lazy.d.ts",
      "default": "./dist/lazy.js"
    },
    "./plugins": {
      "@freecorps/ember-source": "./src/plugins.ts",
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./remote": {
      "@freecorps/ember-source": "./src/remote.ts",
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./session-lookup": {
      "@freecorps/ember-source": "./src/session-lookup.ts",
      "types": "./dist/session-lookup.d.ts",
      "default": "./dist/session-lookup.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun run test:auth && bun run test:plugins && bun run test:node",
    "test:auth": "vitest run --project auth",
    "test:plugins": "vitest run --project plugins",
    "test:node": "vitest run -c vitest.node.config.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "~1.7.28",
    "@better-auth/core": "~1.7.28",
    "@better-auth/utils": "0.5.1",
    "better-auth": "~1.7.28",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@better-auth/expo": "~1.7.28",
    "@better-auth/oauth-provider": "~1.7.28",
    "@better-auth/passkey": "~1.7.28",
    "@better-auth/scim": "~1.7.28",
    "@better-auth/sso": "~1.7.28",
    "@better-auth/stripe": "~1.7.28",
    "@better-auth/test-utils": "~1.7.28",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@freecorps/ember-runtime": "workspace:*",
    "@freecorps/ember-server": "workspace:*",
    "esbuild": "0.28.2",
    "samlify": "2.15.1",
    "stripe": "^20.4.1",
    "wrangler": "^4.157.0"
  }
}
