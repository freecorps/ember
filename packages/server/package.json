{
  "name": "@freecorps/ember-server",
  "version": "0.5.1",
  "description": "Ember server API: defineSchema/defineTable, query/mutation/action builders, query compiler and migrations.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "schema",
    "database",
    "sqlite"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@freecorps/ember-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@freecorps/ember-values": "workspace:*"
  }
}
