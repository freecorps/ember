{
  "name": "@freecorps/ember-client",
  "version": "0.5.9",
  "description": "Ember client: reactive sync over WebSocket with optimistic updates and an optional offline queue.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "sync",
    "websocket",
    "realtime",
    "offline-first"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@freecorps/ember-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests && vitest run -c vitest.workerd.config.ts"
  },
  "dependencies": {
    "@freecorps/ember-values": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@freecorps/ember-runtime": "workspace:*",
    "@freecorps/ember-server": "workspace:*",
    "wrangler": "^4.157.0"
  }
}
