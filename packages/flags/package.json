{
  "name": "@freecorps/ember-flags",
  "version": "0.9.0",
  "description": "Feature flags and remote config for Ember: a .replicated() table written in global:main and evaluated with no round trip in every shard; targeting rules, deterministic percentage rollouts, a pure evaluator for clients and useFlag for React.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "component",
    "feature-flags",
    "remote-config",
    "rollout",
    "experiments"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/flags#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/flags"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "@freecorps/ember-source": "./src/eval.ts",
      "types": "./dist/eval.d.ts",
      "default": "./dist/eval.js"
    },
    "./react": {
      "@freecorps/ember-source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run && vitest run -c vitest.workerd.config.ts"
  },
  "dependencies": {
    "@freecorps/ember-server": "workspace:*",
    "@freecorps/ember-values": "workspace:*"
  },
  "peerDependencies": {
    "@freecorps/ember-react": "workspace:^",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@freecorps/ember-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@freecorps/ember-client": "workspace:*",
    "@freecorps/ember-react": "workspace:*",
    "@freecorps/ember-runtime": "workspace:*",
    "@freecorps/ember-testing": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19",
    "happy-dom": "^21.0.4",
    "react": "19",
    "react-dom": "19",
    "wrangler": "^4.157.0"
  }
}
