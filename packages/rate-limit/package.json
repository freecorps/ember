{
  "name": "@freecorps/ember-rate-limit",
  "version": "0.5.3",
  "description": "Rate limiting component for Ember: token bucket and fixed window per key, stored in the shard and transactional inside mutations; optional Cloudflare Rate Limiting binding helper.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "component",
    "rate-limit",
    "rate-limiter",
    "token-bucket"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/rate-limit#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/rate-limit"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@freecorps/ember-server": "workspace:*",
    "@freecorps/ember-values": "workspace:*"
  }
}
