{
  "name": "@freecorps/ember-dashboard-sdk",
  "version": "0.9.0",
  "description": "SDK for pages embedded in the Ember Dashboard (a component's or app's `embed` block): run the functions the block allows over postMessage, every write confirmed in the dashboard; the dashboard's theme as CSS variables. Zero dependencies, browser-only.",
  "keywords": [
    "ember",
    "cloudflare",
    "dashboard",
    "iframe",
    "sandbox",
    "postmessage",
    "component"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/dashboard-sdk#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/dashboard-sdk"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  }
}
