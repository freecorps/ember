{
  "name": "@freecorps/ember-runtime",
  "version": "0.5.8",
  "description": "Ember runtime for Cloudflare Workers: Durable Object shards with SQLite, transactions, subscriptions, scheduler and files.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "durable-objects",
    "workerd",
    "sqlite"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/runtime"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@freecorps/ember-values": "workspace:*",
    "@freecorps/ember-server": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@freecorps/ember-rate-limit": "workspace:*",
    "@freecorps/ember-workflows": "workspace:*",
    "wrangler": "^4.157.0"
  }
}
