// Test-only Worker config for @cloudflare/vitest-plugin. Never deployed.
{
  "name": "ember-runtime-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SHARD", "class_name": "Shard" },
      { "name": "SYSTEM", "class_name": "System" },
      { "name": "OUTBOX", "class_name": "OutboxBox" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shard", "System", "OutboxBox"] }]
}
