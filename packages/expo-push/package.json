{
  "name": "@freecorps/ember-expo-push",
  "version": "0.4.0",
  "description": "End-to-end encrypted push for Ember Expo apps: device key, Notification Service Extension (iOS) config plugin, Android decrypt task, pure-JS HPKE.",
  "keywords": [
    "ember",
    "expo",
    "react-native",
    "push",
    "apns",
    "fcm",
    "hpke",
    "e2ee",
    "notification-service-extension"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/expo-push#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/expo-push"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app.plugin.cjs": "./app.plugin.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "app.plugin.cjs",
    "ios"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@freecorps/ember-push": "workspace:*",
    "@expo/config-plugins": "~58.0.12"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-constants": "*",
    "expo-crypto": "*",
    "expo-notifications": "*",
    "expo-secure-store": "*",
    "expo-task-manager": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-task-manager": {
      "optional": true
    }
  }
}
