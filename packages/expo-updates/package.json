{
  "name": "@freecorps/ember-expo-updates",
  "version": "0.9.0",
  "description": "Self-hosted EAS Update for Ember: the Expo Updates protocol v1 (signed multipart manifests, rollouts, rollbacks, kill switch) served from the edge cache, assets in R2, and `ember expo publish`.",
  "keywords": [
    "ember",
    "expo",
    "expo-updates",
    "eas-update",
    "ota",
    "react-native",
    "cloudflare",
    "workers",
    "component"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/expo-updates#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/expo-updates"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run && vitest run -c vitest.workerd.config.ts"
  },
  "dependencies": {
    "@freecorps/ember-server": "workspace:*",
    "@freecorps/ember-values": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@freecorps/ember-runtime": "workspace:*",
    "@freecorps/ember-testing": "workspace:*",
    "wrangler": "^4.157.0"
  }
}
