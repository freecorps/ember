{
  "name": "@freecorps/ember-audit",
  "version": "0.9.0",
  "description": "Transactional audit log component for Ember: triggers write one audit row per audited write in the same transaction (changed fields only, redaction, size cap), app-level audit.log, paginated filtered listing, a retention cron that archives old rows to R2 as gzip NDJSON in idempotent batches, and a dashboard screen.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "component",
    "audit",
    "audit-log",
    "triggers",
    "compliance",
    "r2",
    "ndjson"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/audit#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/audit"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run && vitest run -c vitest.workerd.config.ts"
  },
  "dependencies": {
    "@freecorps/ember-server": "workspace:*",
    "@freecorps/ember-values": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@freecorps/ember-runtime": "workspace:*",
    "@freecorps/ember-testing": "workspace:*",
    "wrangler": "^4.157.0"
  }
}
