{
  "name": "@freecorps/ember-sentry",
  "version": "0.9.0",
  "description": "Error tracking for Ember compatible with the Sentry Envelope API: a Queue consumer that groups events into issues, source maps symbolicated in pure JS, payloads in R2, time series in Analytics Engine, alerts.",
  "keywords": [
    "ember",
    "convex",
    "cloudflare",
    "workers",
    "component",
    "sentry",
    "error-tracking",
    "source-maps"
  ],
  "homepage": "https://github.com/freecorps/ember/tree/main/packages/sentry#readme",
  "bugs": {
    "url": "https://github.com/freecorps/ember/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/ember.git",
    "directory": "packages/sentry"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@freecorps/ember-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run && vitest run -c vitest.workerd.config.ts"
  },
  "dependencies": {
    "@freecorps/ember-dashboard-sdk": "workspace:*",
    "@freecorps/ember-server": "workspace:*",
    "@freecorps/ember-values": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@freecorps/ember-runtime": "workspace:*",
    "@freecorps/ember-testing": "workspace:*",
    "wrangler": "^4.157.0"
  }
}
