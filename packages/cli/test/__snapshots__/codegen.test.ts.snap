// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ember codegen > emits static api/dataModel types and a manifest > api.d.ts 1`] = `
"/* eslint-disable */
// Generated by \`ember codegen\`. Do not edit.
// Static function types: args from validators, returns from \`returns\` validators or the TypeScript
// compiler. Imports only ./dataModel (also static), so client code never type-checks server code.
import type { FileId, Id } from "./dataModel";

/** Structurally compatible with @ember/client's and @ember/server's FunctionReference. */
export type FunctionReference<
  Type extends "query" | "mutation" | "action",
  Visibility extends "public" | "internal",
  Args,
  Returns,
> = {
  readonly _type: Type;
  readonly _visibility: Visibility;
  readonly _args: Args;
  readonly _returnType: Returns;
};

/** Public functions (client-callable). */
export declare const api: {
  messages: {
    count: FunctionReference<"query", "public", {
      channel: string;
    }, number>;
    digest: FunctionReference<"action", "public", {
      channel: string;
    }, string>;
    edit: FunctionReference<"mutation", "public", {
      id: Id<"messages">;
      body: string;
    }, null | string>;
    list: FunctionReference<"query", "public", {
      channel: string;
      limit?: number;
    }, {
      _id: Id<"messages">;
      _creationTime: number;
      channel: string;
      author: string;
      body: string;
      edited?: boolean;
    }[]>;
    send: FunctionReference<"mutation", "public", {
      channel: string;
      author: string;
      body: string;
    }, {
      id: Id<"messages">;
      at: number;
    }>;
  };
};

/** Internal functions: callable from other functions, the scheduler and crons only. */
export declare const internal: {
  messages: {
    trim: FunctionReference<"mutation", "internal", {
      channel: string;
      keep: number;
    }, number>;
  };
};

// Keeps the imports used even when no function mentions them.
export type { FileId as _FileId, Id as _Id };
"
`;

exports[`ember codegen > emits static api/dataModel types and a manifest > dataModel.d.ts 1`] = `
"/* eslint-disable */
// Generated by \`ember codegen\`. Do not edit.
// Static document types (from the schema manifest). No imports: safe for client code.

export type Id<TableName extends string> = string & { readonly __tableName: TableName };
export type FileId = string & { readonly __file: true };

export type Documents = {
  messages: {
    _id: Id<"messages">;
    _creationTime: number;
    channel: string;
    author: string;
    body: string;
    edited?: boolean;
  };
};
export type TableNames = keyof Documents & string;
export type Doc<TableName extends TableNames> = Documents[TableName];
"
`;
