exports[`ember codegen > emits static api/dataModel types and a manifest > dataModel.d.ts 1`] = `
"/* eslint-disable */
// Generated by \`ember codegen\`. Do not edit.
// Static document types (from the schema manifest). No imports: safe for client code.

export type Id<TableName extends string> = string & { readonly __tableName: TableName };
export type FileId = string & { readonly __file: true };

export type Documents = {
  messages: {
    _id: Id<"messages">;
    _creationTime: number;
    channel: string;
    author: string;
    body: string;
    edited?: boolean;
  };
};
export type TableNames = keyof Documents & string;
export type Doc<TableName extends TableNames> = Documents[TableName];
"
`;
