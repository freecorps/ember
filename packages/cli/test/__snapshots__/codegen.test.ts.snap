"/* eslint-disable */
// Generated by \`ember codegen\`. Do not edit.
// Static function types: args from validators, returns from \`returns\` validators or the TypeScript
// compiler, errors from \`errors:\` and the handlers. Imports only other generated files, so client code never
// type-checks server code. Go to Definition on \`api.x.y\` opens the handler (api.d.ts.map).
import type { Doc, FileId, Id } from "./dataModel";
import type * as E from "./errors";

/** An application error a function may throw (see ./errors). */
export type ErrorSpec = { readonly code: string; readonly data: unknown };
/** The shard kind a function runs in (\`fromArg\`: the argument holding its key). */
export type ShardSpec = { readonly kind: string; readonly fromArg?: string };

/** Structurally compatible with @freecorps/ember-client's and @freecorps/ember-server's FunctionReference. */
export type FunctionReference<
  Type extends "query" | "mutation" | "action",
  Visibility extends "public" | "internal",
  Args,
  Returns,
  Errors extends ErrorSpec,
> = {
  readonly _type: Type;
  readonly _visibility: Visibility;
  readonly _args: Args;
  readonly _returnType: Returns;
  readonly _errors?: Errors;
};

/** What \`.paginate()\` returns. */
export type PaginationResult<T> = { page: T[]; isDone: boolean; continueCursor: string };

/** A function: \`Query<Args, Returns, Errors>\` (\`never\`: it throws no application error). */
export type Query<Args, Returns, Errors extends ErrorSpec> = FunctionReference<"query", "public", Args, Returns, Errors>;
export type Mutation<Args, Returns, Errors extends ErrorSpec> = FunctionReference<"mutation", "public", Args, Returns, Errors>;
export type Action<Args, Returns, Errors extends ErrorSpec> = FunctionReference<"action", "public", Args, Returns, Errors>;
export type InternalQuery<Args, Returns, Errors extends ErrorSpec> = FunctionReference<"query", "internal", Args, Returns, Errors>;
export type InternalMutation<Args, Returns, Errors extends ErrorSpec> = FunctionReference<"mutation", "internal", Args, Returns, Errors>;
export type InternalAction<Args, Returns, Errors extends ErrorSpec> = FunctionReference<"action", "internal", Args, Returns, Errors>;

/** Public functions (client-callable). */
export declare const api: {
  messages: {
    /**
     * @source ember/messages.ts:18
     */
    count: Query<{
      channel: string;
    }, number, never>;
    /**
     * Actions run in the Worker and may do I/O (fetch, AI, email); they reach the shard through ctx.runQuery,
     * ctx.runMutation and ctx.scheduler (each call is its own transaction).
     *
     * @source ember/messages.ts:49
     */
    digest: Action<{
      channel: string;
    }, string, never>;
    /**
     * @source ember/messages.ts:35
     */
    edit: Mutation<{
      id: Id<"messages">;
      body: string;
    }, string | null, never>;
    /**
     * @source ember/messages.ts:8
     */
    list: Query<{
      channel: string;
      limit?: number;
    }, Doc<"messages">[], never>;
    /**
     * Posts a message to a channel.
     *
     * @throws {MessageTooLong} This message is too long.
     * @source ember/messages.ts:26
     */
    send: Mutation<{
      channel: string;
      author: string;
      body: string;
    }, {
      id: Id<"messages">;
      at: number;
    }, E.MessageTooLong>;
  };
};

/** Internal functions: callable from other functions, the scheduler and crons only. */
export declare const internal: {
  messages: {
    /**
     * Internal: run by the cron in crons.ts.
     *
     * @source ember/messages.ts:58
     */
    trim: InternalMutation<{
      channel: string;
      keep: number;
    }, number, never>;
  };
};

// Keeps the imports used even when no function mentions them.
export type { Doc as _Doc, FileId as _FileId, Id as _Id };
export type _E = E._Errors;
