{
  "name": "@freecorps/ember-example-email-lite",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Smallest app on the Ember email component: mailboxes, send, inbound. Used by the email E2E driver.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
