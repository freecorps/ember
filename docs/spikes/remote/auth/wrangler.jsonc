{
  "name": "ember-spike-auth-bundle",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "AUTH_SHARD", "class_name": "AuthShard" }] },
